@inject IHttpContextAccessor HttpContextAccessor
@{
    var UserId = HttpContextAccessor.HttpContext.Session.GetString("UserId");
    var userRole = HttpContextAccessor.HttpContext.Session.GetString("UserRole");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CedrosNahuizalquenos</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CedrosNahuizalquenos.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/sweetalert/1.1.3/sweetalert.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">




</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-success text-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                @{
                    if (userRole == "Administrador")
                    {
                        <a class="nav-link text-white text-uppercase fw-bold styleBotonsNav" asp-area="" asp-controller="Home" asp-action="InicioAdmin">Inicio</a>
                    }
                    else if (userRole == "Cliente")
                    {
                        <a class="nav-link text-white text-uppercase fw-bold styleBotonsNav" asp-area="" asp-controller="Home" asp-action="InicioClient">Inicio</a>
                    }

                }
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white text-uppercase fw-bold styleBotonsNav " asp-area="" asp-controller="Productoes" asp-action="Index">Catálogo</a>
                        </li>
                    </ul>
                    @{
                        
                        if (userRole == "Administrador")
                        {
                            <ul class="navbar-nav ms-auto">
                                <li class="nav-item">
                                    <a class="nav-link text-white text-uppercase fw-bold fw-boldd styleBotonsNav" asp-area="" asp-controller="Productoes" asp-action="Create">Agregar Producto</a>
                                </li>
                            </ul>
                        }
                    }
                    @{                       
                        if (userRole == "Cliente")
                        {
                            <ul class="navbar-nav ms-auto">
                                <li class="nav-item">
                                    <a class="nav-link position-relative" href="@Url.Action("Carrito", "DetallesPedidoes", new { usuarioId = UserId })">
                                        <img src="/img/anadir-al-carrito.png" alt="Carrito" width="30">
                                        <span id="cartItemCount" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display:none;">
                                            0 <!-- Cantidad de productos en el carrito -->
                                        </span>
                                    </a>
                                </li>
                            </ul>
                        }
                    }
                    <ul class="navbar-nav ms-auto ms-5">
                        <form asp-controller="Usuarios" asp-action="RedirectToLogin" method="post" style="display:inline;">
                            <button class="nav-link position-relative" type="submit" style="border: none; background: none; padding: 0; cursor: pointer;">
                                <img src="~/img/login-out.png" alt="Cerrar Sesión" style="width: 24px; height: 24px;" />
                            </button>
                        </form>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2024 - CedrosNahuizalquenos - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <!-- Referencia al archivo cart.js -->
    <script src="~/js/Admin.js"></script>
    <!-- Popper.js -->
    <!-- Popper.js desde CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.10.2/umd/popper.min.js" integrity="sha512-nnzkI2u2Dy6HMnzMIkh7CPd1KX445z38XIu4jG1jGw7x5tSL3VBjE44dY4ihMU1ijAQV930SPM12cCFrB18sVw==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <!-- Bootstrap JS -->
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert/1.1.3/sweetalert.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function () {
            // Función para obtener la cantidad de pedidos desde el servidor
            function obtenerCantidadPedidos() {
                $.ajax({
                    url: '@Url.Action("ObtenerCantidadCarrito", "Usuarios")', // Cambia "TuControlador" por el nombre de tu controlador
                    type: 'GET',
                    data: { usuarioId: @UserId }, // Envía el ID del usuario autenticado
                    success: function (data) {
                        if (data.success) {
                            updateCartCount(data.count); // Actualiza el contador con la nueva cantidad
                        } else {
                            console.error("Error al obtener la cantidad de pedidos: " + data.message);
                        }
                    },
                    error: function () {
                        console.error("Error al realizar la petición al servidor.");
                    }
                });
            }

            // Llama a la función para obtener la cantidad de pedidos al cargar la página
            obtenerCantidadPedidos();
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
